# ========================
# Infrastructure
# ========================

# --- API Server (Backend) for frontend and game server
API_PROTOCOL=https
API_HOST=

# --- Frontend (Next.js) for api origins
FRONT_HOST=

# --- Game Server (WebSocket) for web client to connect
GAME_SERVER_PROTOCOL=
GAME_SERVER_HOST=

# --- Database (PostgreSQL)
DB_PORT=
DB_HOST=

# ========================
# Database Credentials
# ========================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ========================
# API Server Security
# ========================
KEYPATH=
CREDENTIAL=
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=

# --- Mail Service (Gmail)
GMAIL_ADDRESS=
GMAIL_PASSWORD=

# ========================
# Cookies (Frontend Domain)
# ========================
# Use "localhost" for local development without Domain attribute
COOKIE_DOMAIN=

# ========================
# Game Server
# ========================
LOBBY_CONFIG=
