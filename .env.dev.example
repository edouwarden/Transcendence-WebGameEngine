# ========================
# Infrastructure
# ========================

# --- API Server (Backend) for frontend and game server
API_PROTOCOL=https
API_HOST=localhost:4443

# --- Frontend (Next.js) for api origins
FRONT_HOST=localhost:4443

# --- Extra dev origins allowed to open the Next.js HMR socket (comma separated).
# Use the address you open in the browser, e.g. 192.168.1.20:4443.
DEV_ORIGINS=

# --- Game Server (WebSocket) for web client to connect
GAME_SERVER_PROTOCOL=wss
GAME_SERVER_HOST=localhost:4443

# --- Database (PostgreSQL)
DB_PORT=5432
DB_HOST=db

# ========================
# Database Credentials
# ========================
POSTGRES_USER=parkour
POSTGRES_PASSWORD=parkour
POSTGRES_DB=parkour

# ========================
# API Server Security
# ========================
KEYPATH=/run/secret/private.pem
CREDENTIAL=local-demo-credential
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=https://localhost:4443/api/auth/42/callback

# --- Mail Service (Gmail)
# Optional: leave blank for the local demo, which pre-creates verified users.
GMAIL_ADDRESS=demo@example.com
GMAIL_PASSWORD=

# ========================
# Cookies (Frontend Domain)
# ========================
# Use "localhost" for local development without Domain attribute
COOKIE_DOMAIN=localhost

# ========================
# Game Server
# ========================
LOBBY_CONFIG=one_game
